<!-- ── 청구 모달 ── -->
<div class="modal-overlay" id="claimOverlay" role="dialog" aria-modal="true" aria-label="보험금 청구 접수">
  <div class="modal">
    <div class="modal-hd">
      <div class="modal-hd-title">보험금 청구 접수</div>
      <button class="modal-close" onclick="closeClaimModal()" aria-label="닫기">✕</button>
    </div>
    <div class="modal-body" id="claimForm">
      <div class="form-group">
        <label class="form-label">보험 종류</label>
        <select class="form-select" id="claimType">
          <option value="">선택하세요</option>
          <option>자동차 보험 (K-Auto)</option>
          <option>건강 보험 실손</option>
          <option>탑승 보험</option>
          <option>배달 보험</option>
          <option>응급 의료 보험</option>
          <option>거래 사기 보험</option>
        </select>
      </div>
      <div class="form-group">
        <label class="form-label">사고 일시</label>
        <input class="form-input" type="datetime-local" id="claimDate">
      </div>
      <div class="form-group">
        <label class="form-label">청구 금액 (₮)</label>
        <input class="form-input" type="number" id="claimAmt" placeholder="예: 50000">
        <div class="form-hint">₮1,000,000 이상은 Claude Opus 에스컬레이션 심사</div>
      </div>
      <div class="form-group">
        <label class="form-label">사고 경위 (선택)</label>
        <textarea class="form-textarea" id="claimDesc" placeholder="PDV·K-Traffic·K-Health 데이터가 자동 증거로 사용됩니다. 추가 설명이 있을 경우에만 입력하세요."></textarea>
      </div>
    </div>
    <div class="claim-result" id="claimResult">
      <div class="claim-result-icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5l10 -10"/></svg>
      </div>
      <div class="claim-result-title">청구 접수 완료</div>
      <div class="claim-result-sub" id="claimResultMsg">AI 심사가 시작되었습니다.<br>표준 청구는 0.3초 이내 처리됩니다.</div>
    </div>
    <div class="modal-foot" id="claimFooter">
      <button class="btn" onclick="closeClaimModal()">취소</button>
      <button class="btn btn-brand" onclick="submitClaim()">청구 접수</button>
    </div>
  </div>
</div>

<!-- ── AI 채팅 모달 ── -->
<div class="chat-modal-overlay" id="chatOverlay" role="dialog" aria-modal="true" aria-label="K-Insurance AI 상담">
  <div class="chat-modal">
    <div class="chat-modal-hd">
      <div class="chat-logo">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="width:55%;height:55%" aria-hidden="true"><path d="M12 2L3 7l9 5 9-5-9-5z"/><path d="M3 17l9 5 9-5"/><path d="M3 12l9 5 9-5"/></svg>
      </div>
      <div>
        <div class="chat-title-txt">K-Insurance AI 상담</div>
        <div class="chat-subtitle-txt">DeepSeek V4 Pro · PDV 연동</div>
      </div>
      <button class="chat-close-btn" onclick="closeChat()" aria-label="닫기">✕</button>
    </div>
    <div class="chat-messages" id="chatMessages">
      <div class="chat-msg ai">안녕하세요! K-Insurance AI 상담사입니다.<br>귀하의 PDV·K-Traffic·K-Health 데이터를 기반으로 최적의 보험을 안내합니다. 보험 가입·청구·보험금에 관해 무엇이든 질문하세요.</div>
    </div>
    <div class="chat-input-row">
      <textarea class="chat-input" id="chatInput" placeholder="질문을 입력하세요…" rows="1"
        onkeydown="if(event.key==='Enter'&&!event.shiftKey){event.preventDefault();sendChat();}"></textarea>
      <button class="chat-send-btn" id="chatSendBtn" onclick="sendChat()" aria-label="전송">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 2L11 13"/><path d="M22 2L15 22L11 13L2 9L22 2z"/></svg>
      </button>
    </div>
    <div class="chat-powered">Powered by DeepSeek V4 Pro · gopang-proxy</div>
  </div>
</div>

<!-- ── 플로팅 ── -->
<div class="float">
  <button class="float-btn" onclick="openChat()" aria-label="AI 상담 열기">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
  </button>
  <span class="float-label">AI 상담</span>
</div>

<!-- ── SSO 콜백 + GWP 처리 ── -->
<script>
// GWP 파라미터 파싱
var _params     = new URLSearchParams(location.search);
var _isGwp      = _params.get('gwp') === '1';
var _gwpOrigin  = _params.get('origin') || 'https://gopang.net';
var _gwpContext = null;
try { _gwpContext = _params.get('ctx') ? decodeURIComponent(_params.get('ctx')) : null; } catch {}

window._onGopangAuth = function(user) {
  if (!user) return;

  // 앱 표시 + 스피너 제거
  document.getElementById('auth-loading').style.display = 'none';
  document.getElementById('app').style.display = 'block';

  // 사용자 정보 렌더링 (ipv6 기반)
  var nameEl  = document.getElementById('userName');
  var guidEl  = document.getElementById('userGuid');
  var initEl  = document.getElementById('userInitial');
  var badge   = document.getElementById('auth-badge');

  var displayName = user.name || ('사용자 ' + (user.ipv6 || '').slice(0, 8));
  if (nameEl) nameEl.textContent = displayName;
  if (guidEl) guidEl.textContent = 'IPv6: ' + (user.ipv6 || '').slice(0, 20) + '…';
  if (initEl) initEl.textContent = (user.name || 'K')[0].toUpperCase();

  // 인증 레벨 배지
  if (badge) {
    var lvlColor = { L0:'var(--t3)', L1:'#00bcd4', L2:'var(--brand)', L3:'#ff9800' };
    badge.style.color = lvlColor[user.level] || lvlColor.L0;
    badge.textContent = user.level || 'L0';
    badge.title       = user.ipv6  || '';
  }

  // 상단바 서브타이틀 업데이트
  var subEl = document.getElementById('navSub');
  if (subEl && user.level && user.level !== 'L0') {
    subEl.textContent = 'K-Insurance · ' + user.level + ' 인증 완료';
  }

  // GWP: ctx가 있으면 자동으로 청구 모달 열기
  if (_gwpContext) {
    setTimeout(function() { openClaimModal(); }, 400);
  }

  // URL 정리
  var clean = new URL(location.href);
  ['gwp','gwp_token','ctx','origin'].forEach(function(k){ clean.searchParams.delete(k); });
  history.replaceState({}, '', clean.toString());
};
</script>
<script type="module" src="https://gopang.net/auth/subsystem-auth.js"></script>

<!-- ── 사이드바 스크롤 추적 ── -->
<script>
(function(){
  document.body.classList.add('has-sidebar');
})();
</script>

<!-- ── 청구 모달 ── -->
<script>
function openClaimModal() {
  document.getElementById('claimOverlay').classList.add('open');
  document.getElementById('claimForm').style.display = '';
  document.getElementById('claimResult').classList.remove('visible');
  document.getElementById('claimFooter').style.display = '';
}
function closeClaimModal() {
  document.getElementById('claimOverlay').classList.remove('open');
}
document.getElementById('claimOverlay').addEventListener('click', function(e) {
  if (e.target === this) closeClaimModal();
});
function submitClaim() {
  var type = document.getElementById('claimType').value;
  var amt  = document.getElementById('claimAmt').value;
  if (!type) { alert('보험 종류를 선택해 주세요.'); return; }
  document.getElementById('claimForm').style.display = 'none';
  document.getElementById('claimFooter').style.display = 'none';
  var msgEl = document.getElementById('claimResultMsg');
  var isLarge = parseInt(amt) >= 1000000;
  if (isLarge) {
    msgEl.innerHTML = '고액 청구로 분류되었습니다.<br>Claude Opus + K-Law v15.1 심층 분석이 시작됩니다.<br>처리 시간: 최대 24시간';
  } else {
    msgEl.innerHTML = 'AI 심사가 시작되었습니다.<br>표준 청구는 <strong>0.3초</strong> 이내 처리됩니다.<br>PDV·K-Traffic·K-Health 증거가 자동 수집됩니다.';
  }
  document.getElementById('claimResult').classList.add('visible');
  setTimeout(closeClaimModal, 4000);
}
</script>

<!-- ── AI 채팅 ── -->
<script>
const PROXY_BASE = 'https://gopang-proxy.tensor-city.workers.dev';
const SYSTEM_PROMPT_URL = '/prompts/SP-INS_agent_v2.0.txt';
let INS_SYSTEM_PROMPT = '';
const chatHistory = [];

(async function loadSystemPrompt() {
  try {
    const res = await fetch(SYSTEM_PROMPT_URL);
    if (!res.ok) throw new Error('HTTP ' + res.status);
    const raw = await res.text();
    INS_SYSTEM_PROMPT = raw.split('\n').filter(l => !l.trimStart().startsWith('#')).join('\n').trim();
  } catch (e) {
    INS_SYSTEM_PROMPT = '당신은 K-Insurance AI 보험 상담사입니다. PDV·K-Traffic·K-Health 데이터를 기반으로 보험 가입·청구·보험금에 관해 간결하고 정확하게 답변하세요.';
  }
})();

function openChat() {
  document.getElementById('chatOverlay').classList.add('open');
  document.getElementById('chatInput').focus();
}
function closeChat() {
  document.getElementById('chatOverlay').classList.remove('open');
}
document.getElementById('chatOverlay').addEventListener('click', function(e) {
  if (e.target === this) closeChat();
});

function appendMsg(role, text) {
  var box = document.getElementById('chatMessages');
  var div = document.createElement('div');
  div.className = 'chat-msg ' + (role === 'user' ? 'user' : 'ai');
  div.textContent = text;
  box.appendChild(div);
  box.scrollTop = box.scrollHeight;
  return div;
}

async function sendChat() {
  var input = document.getElementById('chatInput');
  var btn   = document.getElementById('chatSendBtn');
  var text  = input.value.trim();
  if (!text) return;
  input.value = '';
  input.style.height = '';
  btn.disabled = true;
  appendMsg('user', text);
  chatHistory.push({ role: 'user', content: text });
  var typingDiv = appendMsg('ai', '…');
  typingDiv.classList.add('typing');
  try {
    var res = await fetch(PROXY_BASE + '/deepseek', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        model: 'deepseek-v4-pro',
        system: INS_SYSTEM_PROMPT,
        messages: chatHistory.slice(-12),
        max_tokens: 800,
        temperature: 0.6,
        _use_env_key: 'DEEPSEEK_API_KEY',
      })
    });
    var data = await res.json();
    var reply = data?.choices?.[0]?.message?.content || data?.content?.[0]?.text || '죄송합니다, 응답을 받지 못했습니다. 잠시 후 다시 시도해 주세요.';
    typingDiv.classList.remove('typing');
    typingDiv.textContent = reply;
    chatHistory.push({ role: 'assistant', content: reply });
  } catch (err) {
    typingDiv.classList.remove('typing');
    typingDiv.textContent = '네트워크 오류가 발생했습니다. 잠시 후 다시 시도해 주세요.';
  } finally {
    btn.disabled = false;
    input.focus();
  }
}

document.getElementById('chatInput').addEventListener('input', function() {
  this.style.height = '';
  this.style.height = Math.min(this.scrollHeight, 100) + 'px';
});
</script>

</body>
</html>
